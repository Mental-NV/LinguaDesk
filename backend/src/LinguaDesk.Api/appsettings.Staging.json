{
  "Deployment": {
    "AzureAppService": true
  },
  "Storage": {
    "DatabasePath": "/home/linguadesk/data/linguadesk.db",
    "JournalMode": "Delete",
    "BackupPath": "/home/linguadesk/backups"
  },
  "Security": {
    "DataProtectionKeysPath": "/home/linguadesk/keys"
  },
  "Telemetry": {
    "Enabled": true,
    "SamplingRatio": 0.05
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
