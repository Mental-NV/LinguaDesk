param name string
param planName string
param location string
@allowed(['Staging', 'Production'])
param environment string
@secure()
param providerKey string
param monitoringConnection string
// New apps stay stopped and runtime telemetry is disabled until both caps pass readback.
param enabled bool = false
resource plan 'Microsoft.Web/serverfarms@2024-11-01' = {
  name: planName
  location: location
  kind: 'linux'
  sku: { name: 'F1', tier: 'Free', capacity: 1 }
  properties: { reserved: true }
}
resource app 'Microsoft.Web/sites@2024-11-01' = {
  name: name
  location: location
  kind: 'app,linux'
  properties: {
    // Omit autoGeneratedDomainNameLabelScope to request the classic exact hostname.
    // Deployment also rejects any returned hashed/regional hostname before activation.
    serverFarmId: plan.id
    enabled: true
    httpsOnly: true
    clientAffinityEnabled: false
    publicNetworkAccess: 'Enabled'
    siteConfig: {
      linuxFxVersion: 'DOTNETCORE|10.0'
      appCommandLine: 'bash /home/site/wwwroot/start.sh'
      alwaysOn: false
      numberOfWorkers: 1
      // F1 rejects an explicit 64-bit worker request, including on Linux apps.
      use32BitWorkerProcess: true
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      scmIpSecurityRestrictionsUseMain: false
      appSettings: [
        { name: 'ASPNETCORE_ENVIRONMENT', value: environment }
        { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: monitoringConnection }
        { name: 'LINGUADESK_AIEVALUATION__CREDENTIALS__DEEPSEEK__APIKEY', value: providerKey }
        { name: 'Telemetry__Enabled', value: enabled ? 'true' : 'false' }
        { name: 'Deployment__Enabled', value: enabled ? 'true' : 'false' }
        { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'false' }
        { name: 'ENABLE_ORYX_BUILD', value: 'false' }
        { name: 'WEBSITES_ENABLE_APP_SERVICE_STORAGE', value: 'true' }
        { name: 'WEBSITE_RUN_FROM_PACKAGE', value: '0' }
      ]
    }
  }
}
output appName string = app.name
output hostname string = app.properties.defaultHostName
